<mxCell id="ep" value="&lt;b&gt;Azure ML managed online endpoint · fraud-scoring-prod&lt;/b&gt;&lt;br&gt;Entra ID auth · private endpoint · p99 ≤ 120 ms · ≥ 28 tps per DS3_v2 instance · Owner: MLOps" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#C4314B;fontColor=#252423;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="340" y="52" width="530" height="172" as="geometry"/></mxCell>
<mxCell id="acct1" value="&lt;b&gt;fraudmlstore · GPv2 · LRS · soft delete 14 d · old versions purged at 30 d · lifecycle policy&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;fontColor=#252423;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="898" height="160" as="geometry"/></mxCell>
<mxCell id="acct2" value="&lt;b&gt;fraudmlaudit (new) · GRS · WORM&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;fontColor=#252423;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="990" y="470" width="397" height="160" as="geometry"/></mxCell>
<mxCell id="aml" value="&lt;b&gt;Azure ML workspace · fraud-ml-workspace · private endpoint · Owner: DS (models) / MLOps (platform)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#252423;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="660" width="898" height="234" as="geometry"/></mxCell>
<mxCell id="gw" value="&lt;b&gt;Payment gateway (fraud-check client)&lt;/b&gt;&lt;br&gt;POS · web · mobile; owned by Payments&lt;br&gt;Sends keyed card hash (HMAC), never PAN&lt;br&gt;Client timeout 250 ms → rules-based fallback" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;fontColor=#252423;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="70" width="210" height="140" as="geometry"/></mxCell>
<mxCell id="live" value="&lt;b&gt;LIVE slot (blue/green alternate)&lt;/b&gt;&lt;br&gt;Champion 3.x · 100% traffic&lt;br&gt;Autoscale 3–6 × DS3_v2&lt;br&gt;CPU &amp;gt; 70% for 5 min → +1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4314B;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="352" y="106" width="165" height="108" as="geometry"/></mxCell>
<mxCell id="cand" value="&lt;b&gt;CANDIDATE slot&lt;/b&gt;&lt;br&gt;0% load test → 20% mirrored shadow → 10% canary → 100%&lt;br&gt;2 instances until promoted" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4314B;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="527" y="106" width="175" height="108" as="geometry"/></mxCell>
<mxCell id="stby" value="&lt;b&gt;STANDBY (previous)&lt;/b&gt;&lt;br&gt;0% traffic · 2 warm instances · kept 7 days&lt;br&gt;Rollback = traffic switch" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4314B;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="712" y="106" width="148" height="108" as="geometry"/></mxCell>
<mxCell id="redis" value="&lt;b&gt;Azure Managed Redis · online feature store&lt;/b&gt;&lt;br&gt;Batch features (hourly) + per-card velocity state&lt;br&gt;HA replica · clustered · private endpoint&lt;br&gt;Read timeout 25 ms → fallback values + flag&lt;br&gt;Owner: DS (features) / MLOps (infra)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F0FF;strokeColor=#0078D4;fontColor=#252423;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="930" y="62" width="262" height="150" as="geometry"/></mxCell>
<mxCell id="stamps" value="&lt;b&gt;Regional stamps&lt;/b&gt;&lt;br&gt;East US 2: primary (shown)&lt;br&gt;West Europe: EU-resident data, same Terraform and workflows&lt;br&gt;Central US: recovery target (IaC redeploy)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8886;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1212" y="62" width="175" height="150" as="geometry"/></mxCell>
<mxCell id="ehtx" value="&lt;b&gt;Event Hubs · transactions&lt;/b&gt;&lt;br&gt;fraud-events-ns · 16 partitions&lt;br&gt;Retention 72 h · Capture (Avro, 5-min files)&lt;br&gt;Peak 28 eps · Black Friday 97 eps&lt;br&gt;2 TU, auto-inflate to 4" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F0FF;strokeColor=#0078D4;fontColor=#252423;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="268" width="210" height="130" as="geometry"/></mxCell>
<mxCell id="ehtel" value="&lt;b&gt;Event Hubs · scoring-telemetry&lt;/b&gt;&lt;br&gt;8 partitions · retention 72 h&lt;br&gt;1 event per scored txn (~3 KB): features, score, SHAP, drift bins" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F0FF;strokeColor=#0078D4;fontColor=#252423;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="340" y="268" width="205" height="130" as="geometry"/></mxCell>
<mxCell id="asa" value="&lt;b&gt;Stream Analytics · fraud-telemetry-job&lt;/b&gt;&lt;br&gt;3 SU (6 SU for peak events)&lt;br&gt;1-h bin counts per feature (drift)&lt;br&gt;5-min ops aggregates per slot&lt;br&gt;Pass-through of every scored txn" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F4F4;strokeColor=#038387;fontColor=#252423;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="605" y="262" width="215" height="142" as="geometry"/></mxCell>
<mxCell id="func" value="&lt;b&gt;Function app · func-fraud-ops&lt;/b&gt;&lt;br&gt;drift-evaluator: PSI · KS · KL · PFR&lt;br&gt;rollback-controller · notifier" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F4F4;strokeColor=#038387;fontColor=#252423;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="878" y="258" width="212" height="88" as="geometry"/></mxCell>
<mxCell id="sb" value="&lt;b&gt;Service Bus · fraud-review queue&lt;/b&gt;&lt;br&gt;Score ≥ 0.85 → fraud operations" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F0FF;strokeColor=#0078D4;fontColor=#252423;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="878" y="362" width="212" height="74" as="geometry"/></mxCell>
<mxCell id="mon" value="&lt;b&gt;Azure Monitor + Log Analytics&lt;/b&gt;&lt;br&gt;fraud-ml-logs&lt;br&gt;Endpoint metrics, DriftResults_CL, FraudOps_CL, PerfResults_CL&lt;br&gt;Alert rules → action groups: Slack, email, PagerDuty&lt;br&gt;90 d interactive + 2 y long-term" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F4F4;strokeColor=#038387;fontColor=#252423;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1152" y="258" width="235" height="178" as="geometry"/></mxCell>
<mxCell id="raw" value="&lt;b&gt;raw-transactions&lt;/b&gt;&lt;br&gt;Event Hubs Capture (Avro)&lt;br&gt;Hot 30 d → Cool 90 d → Cold 400 d → Archive&lt;br&gt;Delete at 2 y · ~2.1 TB/mo" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#CA5010;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="168" height="122" as="geometry"/></mxCell>
<mxCell id="feat" value="&lt;b&gt;features&lt;/b&gt;&lt;br&gt;Online snapshots: Hot 7 d → Cool, delete 60 d&lt;br&gt;Training snapshots: Hot 30 d → Cool 180 d → Cold 365 d → Archive, 7 y" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#CA5010;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="256" y="500" width="168" height="122" as="geometry"/></mxCell>
<mxCell id="exp" value="&lt;b&gt;experiments (MLflow)&lt;/b&gt;&lt;br&gt;Hot 30 d → Cool → deleted at 90 d&lt;br&gt;Registered packages are copied to models first" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#CA5010;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="432" y="500" width="168" height="122" as="geometry"/></mxCell>
<mxCell id="models" value="&lt;b&gt;models (registry packages)&lt;/b&gt;&lt;br&gt;Blob index-tag rules: rejected 90 d · staging 2 y · production 2 y&lt;br&gt;+ 7 y copy in audit-7y" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#CA5010;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="608" y="500" width="168" height="122" as="geometry"/></mxCell>
<mxCell id="tele" value="&lt;b&gt;telemetry&lt;/b&gt;&lt;br&gt;Ops aggregates, load-test reports&lt;br&gt;Hot 30 d → Cool 365 d → Cold, delete 2 y" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#CA5010;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="784" y="500" width="176" height="122" as="geometry"/></mxCell>
<mxCell id="a7" value="&lt;b&gt;audit-7y  (WORM, locked 7 y)&lt;/b&gt;&lt;br&gt;Per-prediction features + score + SHAP&lt;br&gt;Production lineage + approvals&lt;br&gt;Drift &amp;amp; rollback decisions&lt;br&gt;Hot 30 d → Cool 90 d → Cold 365 d → Archive" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBE9D7;strokeColor=#8E562E;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1000" y="500" width="205" height="122" as="geometry"/></mxCell>
<mxCell id="a2" value="&lt;b&gt;audit-2y  (WORM 2 y)&lt;/b&gt;&lt;br&gt;GitHub run logs + approval records&lt;br&gt;Nightly export · Cool tier" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBE9D7;strokeColor=#8E562E;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1213" y="500" width="166" height="122" as="geometry"/></mxCell>
<mxCell id="fp" value="&lt;b&gt;Feature pipelines (shared fraudshield_features library)&lt;/b&gt;&lt;br&gt;Hourly: materialize batch features → Redis&lt;br&gt;Weekly: point-in-time training snapshot → features&lt;br&gt;Offline/online parity test in CI" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="82" y="690" width="342" height="92" as="geometry"/></mxCell>
<mxCell id="mlf" value="&lt;b&gt;MLflow tracking&lt;/b&gt;&lt;br&gt;fraud-detection-classification-v3&lt;br&gt;Run contract: 20 params · 16 metrics · 12 tags" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="432" y="690" width="168" height="92" as="geometry"/></mxCell>
<mxCell id="reg" value="&lt;b&gt;Model registry&lt;/b&gt;&lt;br&gt;fraud-detection-xgboost&lt;br&gt;lifecycle + role tags · semver 3.x.y" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="608" y="690" width="168" height="92" as="geometry"/></mxCell>
<mxCell id="train" value="&lt;b&gt;Training cluster · fraud-train-cluster&lt;/b&gt;&lt;br&gt;0–8 × DS3_v2, low-priority · weekly + drift-triggered retrain&lt;br&gt;Daily warm-start challenger (evaluated, not auto-deployed)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="82" y="794" width="342" height="90" as="geometry"/></mxCell>
<mxCell id="perf" value="&lt;b&gt;perf-monitor (daily 06:00 UTC)&lt;/b&gt;&lt;br&gt;Joins chargeback labels (24–72 h lag) with audit-7y predictions&lt;br&gt;→ PerfResults_CL: recall, AUC, F1 per D-3 cohort" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="608" y="794" width="352" height="90" as="geometry"/></mxCell>
<mxCell id="acr" value="&lt;b&gt;Container Registry · fraudmlacr&lt;/b&gt;&lt;br&gt;Scoring image, digest-pinned&lt;br&gt;Untagged manifests purged at 30 d" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#605E5C;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1000" y="662" width="205" height="76" as="geometry"/></mxCell>
<mxCell id="kv" value="&lt;b&gt;Key Vault · fraud-ml-kv + identities&lt;/b&gt;&lt;br&gt;HMAC, CMK and GitHub App keys&lt;br&gt;Managed identities; GitHub → Azure via OIDC (no stored secrets)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#605E5C;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1000" y="748" width="205" height="100" as="geometry"/></mxCell>
<mxCell id="gh" value="&lt;b&gt;GitHub · fraudshield-mlops&lt;/b&gt;&lt;br&gt;ml-release: test → build → validate → promote (approval) → deploy&lt;br&gt;ml-pipeline-rollback&lt;br&gt;audit-export (nightly)&lt;br&gt;Self-hosted runners in VNet" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFE9F6;strokeColor=#5C2D91;fontColor=#252423;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1213" y="662" width="174" height="222" as="geometry"/></mxCell>
